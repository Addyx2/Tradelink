generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum ShipmentStatus {
  IN_TRANSIT
  AT_PORT
  CUSTOMS_HOLD
  DELIVERED
}

enum ComplianceStatus {
  READY
  REVIEW
  BLOCKED
}

enum TelemetryStatus {
  HEALTHY
  WARNING
  CRITICAL
}

enum EbdlStatus {
  ISSUED
  AMENDED
  AWAITING_RELEASE
}

enum ForestRisk {
  LOW
  MEDIUM
  HIGH
}

enum UserRole {
  TRADEMASTER
  TRADE_OFFICER_COMPLIANCE
  TRADE_OFFICER_INSPECTION
  SUPPLIER
  CLIENT
}

model Organization {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  users       User[]
  shipments   Shipment[]
  batches     Batch[]
  suppliers   Supplier[]
  documents   EbdlRecord[]
  incidents   Incident[]
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String
  password       String?
  emailVerified  DateTime?
  image          String?
  role           UserRole     @default(CLIENT)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accounts       Account[]
  sessions       Session[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Supplier {
  id                 String       @id @default(cuid())
  externalId         String
  name               String
  country            String
  trustScore         Int          @default(0)
  activeBatches      Int          @default(0)
  compliancePassRate Int          @default(0)
  incidents          Int          @default(0)
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  batches            Batch[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([organizationId, externalId])
}

model Batch {
  id               String            @id @default(cuid())
  externalId       String
  commodity        String
  volume           String
  originCountry    String
  forestRisk       ForestRisk
  coordinates      String
  evidenceComplete Int               @default(0)
  complianceStatus ComplianceStatus
  organizationId   String
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId       String
  supplier         Supplier          @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  shipments        ShipmentBatch[]
  incidents        Incident[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([organizationId, externalId])
}

model Shipment {
  id               String           @id @default(cuid())
  externalId       String
  route            String
  origin           String
  destination      String
  eta              DateTime
  status           ShipmentStatus
  carrier          String
  vehicle          String
  telemetryHealth  Int              @default(0)
  riskScore        Int              @default(0)
  organizationId   String
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ebdlRecordId     String?
  ebdlRecord       EbdlRecord?      @relation(fields: [ebdlRecordId], references: [id], onDelete: SetNull)
  telemetryEvents  TelemetryEvent[]
  shipmentBatches  ShipmentBatch[]
  alerts           ShipmentAlert[]
  incidents        Incident[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([organizationId, externalId])
}

model ShipmentBatch {
  shipmentId String
  batchId    String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  batch      Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([shipmentId, batchId])
}

model TelemetryEvent {
  id            String          @id @default(cuid())
  externalId    String
  shipmentId    String
  shipment      Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  timestamp     DateTime
  location      String
  temperatureC  Float
  humidity      Float
  status        TelemetryStatus
  note          String
  createdAt     DateTime        @default(now())

  @@unique([shipmentId, externalId])
}

model ShipmentAlert {
  id         String   @id @default(cuid())
  shipmentId String
  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  message    String
  createdAt  DateTime @default(now())
}

model EbdlRecord {
  id             String       @id @default(cuid())
  externalId     String
  issueDate      DateTime
  version        String
  shipper        String
  consignee      String
  carrier        String
  cargo          String
  status         EbdlStatus
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipments      Shipment[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, externalId])
}

model Incident {
  id             String       @id @default(cuid())
  title          String
  severity       String
  status         String
  shipmentId     String?
  shipment       Shipment?    @relation(fields: [shipmentId], references: [id], onDelete: SetNull)
  batchId        String?
  batch          Batch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
